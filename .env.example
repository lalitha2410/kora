# All five are optional, but at least one must be set. Every configured
# provider is tried automatically, in this order, falling back on a rate
# limit, a network failure, a 5xx, or a 15s timeout — see src/lib/llmProvider.ts.
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_CEREBRAS_API_KEY=your_cerebras_api_key_here
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_MISTRAL_API_KEY=your_mistral_api_key_here
VITE_SAMBANOVA_API_KEY=your_sambanova_api_key_here
